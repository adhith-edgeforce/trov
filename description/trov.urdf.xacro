        </noise>
      </lidar>
      <alwaysOn>1</alwaysOn>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo> -->

  <!-- ================= ROS2 CONTROL - HARDWARE INTERFACE ================= -->
  <!-- 
    gz_ros2_control replaces the old DiffDrive + JointStatePublisher Gz plugins.
    In simulation:  hardware interface = gz_ros2_control/GazeboSimSystem
    On real robot:  swap the plugin filename + hardware interface to your motor driver.
    The diff_drive_controller groups front+rear wheels per side = skid steer behaviour.
  -->
  <ros2_control name="trov_drive" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gz_ros2_control Gazebo plugin - loads the ros2_control manager inside Gz -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find trov)/config/controllers.yaml</parameters>
      <ros>
        <remapping>~/robot_description:=robot_description</remapping>
        <!-- Remap diff_drive_controller's cmd_vel to /cmd_vel (collision_monitor output) -->
        <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- ================= GAZEBO VISUAL MATERIALS ================= -->
  <gazebo reference="chassis">
    <material>Gazebo/Red</material>
  </gazebo>

